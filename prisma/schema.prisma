generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id            Int         @id @default(autoincrement())
  tableNumber   String
  customerName  String
  items         String
  totalAmount   Float
  status        String      @default("PENDING")
  estimatedTime Int         @default(15)
  isManual      Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  amount      Float
  date        String
  createdAt   DateTime @default(now())
}
